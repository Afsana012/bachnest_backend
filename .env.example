# Application Configuration
APP_NAME=BachNest API
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL + PostGIS Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bachnest
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bachnest

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & JWT Token
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment Provider (mock | sslcommerz | bkash)
PAYMENT_PROVIDER=mock
BKASH_APP_KEY=
BKASH_APP_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# SMS Provider (mock | sslwireless)
SMS_PROVIDER=mock
SMS_API_KEY=

# Email Provider (mock | smtp)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Celery Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
